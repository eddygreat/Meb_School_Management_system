{
    "name": "meb-school-management-system-root",
    "version": "1.0.0",
    "description": "Root package.json for convenience scripts",
    "scripts": {
        "dev": "npm run dev --prefix frontend",
        "build": "npm run build --prefix frontend",
        "install:frontend": "npm install --prefix frontend",
        "install:backend": "pip install -r backend/requirements.txt",
        "start:backend": "backend\\venv\\Scripts\\uvicorn app.main:app --app-dir backend --reload"
    }
}