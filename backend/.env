# This file is for local development secrets and should NOT be committed to git.
# Make sure '.env' is in your .gitignore file.

# Generate a strong secret key using a command like: openssl rand -hex 32
SECRET_KEY="your_super_secret_key_generated_with_openssl"

# Your local PostgreSQL database connection string.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL="postgresql+asyncpg://postgres:mysecretpassword@localhost:5432/school_db"

# Optional payment gateway keys for development
PAYSTACK_SECRET_KEY="your_paystack_test_secret_key"
FLUTTERWAVE_SECRET_KEY="your_flutterwave_test_secret_key"